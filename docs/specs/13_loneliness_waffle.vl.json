{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: share of people aged 15+ who often feel very lonely in the selected place. Each square is one percentage point.",
  "params": [{"name": "focus", "value": "AUS"}],
  "data": {"url": "data/lonely_waffle.json"},
  "transform": [{"filter": "datum.state === focus"}],
  "width": "container",
  "height": 170,
  "mark": {"type": "rect", "cornerRadius": 2, "stroke": "#FFFFFF", "strokeWidth": 2},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {"field": "filled", "type": "nominal", "scale": {"domain": [true, false], "range": ["#F76707", "#E3E9F4"]}, "legend": null},
    "tooltip": [
      {"field": "state", "title": "Place"},
      {"field": "lonely", "type": "quantitative", "title": "Often feel very lonely (%)", "format": ".1f"}
    ]
  }
}
