{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of participation rates (age 15+) in recreational walking, swimming and cycling by state and territory.",
  "params": [{"name": "focus", "value": "AUS"}],
  "data": {"url": "data/activities.json"},
  "width": "container",
  "height": 280,
  "encoding": {
    "x": {"field": "activity", "type": "nominal", "sort": ["Walking", "Swimming", "Cycling"], "axis": {"title": null, "labelAngle": 0, "orient": "top", "domain": false, "ticks": false}},
    "y": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "axis": {"title": null, "domain": false, "ticks": false}}
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#FFFFFF", "strokeWidth": 3},
      "encoding": {
        "color": {
          "field": "rate",
          "type": "quantitative",
          "scale": {"domain": [0, 60], "range": ["#FFF3BF", "#F76707"]},
          "legend": {"orient": "bottom", "title": "Participation (%)", "gradientLength": 160}
        },
        "opacity": {"condition": {"test": "focus === 'AUS' || datum.state === focus", "value": 1}, "value": 0.35},
        "tooltip": [
          {"field": "state", "title": "Place"},
          {"field": "activity", "title": "Activity"},
          {"field": "rate", "type": "quantitative", "title": "Participation (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12},
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".0f"},
        "color": {"condition": {"test": "datum.rate > 35", "value": "#FFFFFF"}, "value": "#1B1F4B"},
        "opacity": {"condition": {"test": "focus === 'AUS' || datum.state === focus", "value": 1}, "value": 0.35}
      }
    }
  ]
}
