{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Arrow-style dumbbell chart: share of people reporting a great sense of belonging in Australia, by generation and birthplace, in 2010-12 (hollow point) and 2025 (filled point).",
  "data": {"url": "data/belonging.json"},
  "transform": [{"calculate": "datum.now - datum.before", "as": "change"}],
  "facet": {
    "row": {
      "field": "birthplace",
      "type": "nominal",
      "sort": ["Born in Australia", "Born overseas"],
      "header": {"title": null, "labelAngle": 0, "labelAlign": "left", "labelAnchor": "start", "labelFontSize": 13, "labelFontWeight": "bold", "labelPadding": 6, "labelOrient": "top"}
    }
  },
  "spacing": 18,
  "spec": {
    "width": "container",
    "height": 150,
    "encoding": {
      "y": {"field": "generation", "type": "nominal", "sort": ["Silent generation", "Baby boomers", "Gen X", "Millennials", "Gen Z"], "axis": {"title": null, "labelPadding": 8}},
      "x": {"type": "quantitative", "scale": {"domain": [0, 100]}}
    },
    "layer": [
      {
        "mark": {"type": "rule", "strokeWidth": 3, "color": "#CDD3E0"},
        "encoding": {"x": {"field": "before", "type": "quantitative", "axis": {"title": "Great sense of belonging (%)"}}, "x2": {"field": "now"}}
      },
      {
        "mark": {"type": "point", "size": 110, "filled": false, "strokeWidth": 2, "color": "#5C5F7A"},
        "encoding": {
          "x": {"field": "before", "type": "quantitative"},
          "tooltip": [
            {"field": "generation", "title": "Generation"},
            {"field": "before", "type": "quantitative", "title": "2010–12 (%)"}
          ]
        }
      },
      {
        "mark": {"type": "point", "size": 130, "filled": true, "color": "#7048E8", "opacity": 1},
        "encoding": {
          "x": {"field": "now", "type": "quantitative"},
          "tooltip": [
            {"field": "generation", "title": "Generation"},
            {"field": "before", "type": "quantitative", "title": "2010–12 (%)"},
            {"field": "now", "type": "quantitative", "title": "2025 (%)"},
            {"field": "change", "type": "quantitative", "title": "Change (points)", "format": "+d"}
          ]
        }
      },
      {
        "transform": [{"filter": "datum.change <= -20"}],
        "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 11, "fontStyle": "italic", "fontWeight": "bold", "color": "#F76707"},
        "encoding": {"x": {"field": "before", "type": "quantitative"}, "text": {"field": "change", "type": "quantitative", "format": "+d"}}
      },
      {
        "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 11, "fontWeight": "bold", "color": "#7048E8"},
        "encoding": {"x": {"field": "now", "type": "quantitative"}, "text": {"field": "now", "type": "quantitative", "format": ".0f"}}
      }
    ]
  }
}
