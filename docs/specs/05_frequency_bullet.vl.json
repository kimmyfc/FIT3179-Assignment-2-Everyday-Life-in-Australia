{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bullet-style chart of the share of people active three or more times a week in each state and territory, against the national rate.",
  "params": [{"name": "focus", "value": "AUS"}],
  "data": {"url": "data/sport.json"},
  "transform": [
    {"calculate": "datum.state === 'AUS' ? datum.three : null", "as": "national"},
    {"joinaggregate": [{"op": "max", "field": "national", "as": "benchmark"}]},
    {"filter": "datum.state !== 'AUS'"}
  ],
  "width": "container",
  "height": 280,
  "encoding": {
    "y": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "axis": {"title": null, "labelPadding": 9}}
  },
  "layer": [
    {
      "mark": {"type": "bar", "height": 22, "cornerRadiusEnd": 2},
      "encoding": {
        "x": {"field": "three", "type": "quantitative", "scale": {"domain": [0, 65]}, "axis": {"title": "Active three or more times a week (%)", "tickCount": 7}},
        "color": {"condition": {"test": "datum.state === focus", "value": "#F76707"}, "value": "#74C0FC"},
        "tooltip": [
          {"field": "state", "title": "Place"},
          {"field": "three", "type": "quantitative", "title": "3+ times a week (%)", "format": ".1f"},
          {"field": "benchmark", "type": "quantitative", "title": "Australia (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "tick", "thickness": 3, "size": 30, "color": "#1B1F4B"},
      "encoding": {"x": {"field": "benchmark", "type": "quantitative"}}
    },
    {
      "transform": [{"filter": "datum.state === 'NSW'"}],
      "mark": {"type": "text", "align": "center", "baseline": "bottom", "dy": -16, "fontSize": 11, "fontWeight": "bold", "color": "#1B1F4B"},
      "encoding": {"x": {"field": "benchmark", "type": "quantitative"}, "text": {"value": "Australia 50.1%"}}
    },
    {
      "transform": [{"filter": "datum.state === 'ACT'"}],
      "mark": {"type": "text", "align": "left", "dx": 40, "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"x": {"field": "three", "type": "quantitative"}, "text": {"value": "highest"}}
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 11, "color": "#1B1F4B"},
      "encoding": {
        "x": {"field": "three", "type": "quantitative"},
        "text": {"field": "three", "type": "quantitative", "format": ".1f"}
      }
    }
  ]
}
