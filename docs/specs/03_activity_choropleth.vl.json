{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of weekly sport and physical activity participation (age 15+) by state and territory. The focus parameter outlines the selected place.",
  "params": [{"name": "focus", "value": "AUS"}],
  "width": "container",
  "height": 340,
  "projection": {"type": "conicEqualArea", "rotate": [-134, 0], "parallels": [-18, -36]},
  "layer": [
    {
      "data": {"url": "data/aus-states.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {"lookup": "properties.state", "from": {"data": {"url": "data/sport.json"}, "key": "state", "fields": ["weekly", "three"]}}
      ],
      "mark": {"type": "geoshape", "strokeWidth": 1.2, "cursor": "pointer"},
      "encoding": {
        "color": {
          "field": "weekly",
          "type": "quantitative",
          "title": "Active at least weekly (%)",
          "scale": {"domain": [65, 80], "range": ["#FFF3BF", "#F76707"]},
          "legend": {"orient": "bottom", "gradientLength": 170}
        },
        "stroke": {"condition": {"test": "datum.properties.state === focus", "value": "#1B1F4B"}, "value": "#FFFFFF"},
        "strokeWidth": {"condition": {"test": "datum.properties.state === focus", "value": 3}, "value": 1.2},
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Place"},
          {"field": "weekly", "type": "quantitative", "title": "At least weekly (%)", "format": ".1f"},
          {"field": "three", "type": "quantitative", "title": "3+ times a week (%)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Callouts for the highest and lowest places.",
      "data": {"values": [
        {"lon": 124, "lat": -37.4, "note": "Highest: ACT 78.3% (see inset)"},
        {"lon": 124, "lat": -39.6, "note": "Lowest: SA 67.0%"}
      ]},
      "mark": {"type": "text", "align": "center", "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"longitude": {"field": "lon", "type": "quantitative"}, "latitude": {"field": "lat", "type": "quantitative"}, "text": {"field": "note"}}
    }
  ]
}
