{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mean overall life satisfaction (0 to 10) for three age groups in the 2014, 2019, 2020 and 2025 General Social Surveys.",
  "data": {"url": "data/satisfaction.json"},
  "width": "container",
  "height": 300,
  "encoding": {
    "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2013, 2026]}, "axis": {"title": "Survey year", "values": [2014, 2019, 2020, 2025], "format": "d", "grid": false}},
    "y": {"field": "score", "type": "quantitative", "scale": {"domain": [6, 8.5]}, "axis": {"title": "Mean life satisfaction (out of 10)", "tickCount": 5}},
    "color": {
      "field": "age",
      "type": "nominal",
      "scale": {"domain": ["15–24", "35–44", "65+"], "range": ["#F76707", "#FAB005", "#1C7ED6"]},
      "legend": null
    }
  },
  "layer": [
    {
      "data": {"values": [{"year": 2020}]},
      "mark": {"type": "rule", "strokeDash": [4, 4], "color": "#A9AFC2"},
      "encoding": {"x": {"field": "year", "type": "quantitative"}, "y": null, "color": {"value": "#A9AFC2"}}
    },
    {
      "data": {"values": [{"year": 2020.3, "score": 6.75, "note": "2020: the biggest drop, for 15–24s"}]},
      "mark": {"type": "text", "align": "left", "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"text": {"field": "note"}, "color": {"value": "#3F4366"}}
    },
    {
      "mark": {"type": "line", "strokeWidth": 3, "point": {"filled": true, "size": 75}},
      "encoding": {
        "tooltip": [
          {"field": "age", "title": "Age group"},
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "score", "type": "quantitative", "title": "Mean score", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year === 2025"}, {"calculate": "'Aged ' + datum.age", "as": "label"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "fontWeight": "bold"},
      "encoding": {"text": {"field": "label"}}
    }
  ]
}
