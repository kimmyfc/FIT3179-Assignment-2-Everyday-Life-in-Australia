{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: estimated people aged 15+ who attended a selected cultural venue or event in the past 12 months, by state and territory.",
  "width": "container",
  "height": 330,
  "projection": {"type": "conicEqualArea", "rotate": [-134, 0], "parallels": [-18, -36]},
  "layer": [
    {
      "data": {"url": "data/aus-states.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#E3E9F4", "stroke": "#FFFFFF", "strokeWidth": 1}
    },
    {
      "data": {"url": "data/community.json"},
      "transform": [{"filter": "datum.state !== 'AUS'"}],
      "mark": {"type": "circle", "fill": "#F76707", "stroke": "#FFF8E1", "strokeWidth": 1.3, "opacity": 0.8},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "cultural_thousands",
          "type": "quantitative",
          "scale": {"domain": [0, 5400], "range": [0, 3800]},
          "legend": {"orient": "bottom", "title": "Attendees (thousands)", "values": [200, 1000, 3000, 5000], "symbolFillColor": "#F76707", "symbolStrokeColor": "#FFF8E1"}
        },
        "tooltip": [
          {"field": "state", "title": "Place"},
          {"field": "cultural_thousands", "type": "quantitative", "title": "Attendees (thousands)", "format": ",.1f"},
          {"field": "cultural_rate", "type": "quantitative", "title": "Share of people 15+ (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"url": "data/community.json"},
      "transform": [{"filter": "datum.state !== 'AUS' && datum.cultural_thousands > 600"}],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#FFFFFF"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state"}
      }
    }
  ]
}
