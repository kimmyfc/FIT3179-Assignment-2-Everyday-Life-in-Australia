{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Index chart of four national public library measures from 2019-20 to 2023-24, each scaled so 2019-20 equals 100.",
  "data": {"url": "data/library_trend.json"},
  "transform": [
    {"window": [{"op": "first_value", "field": "value", "as": "baseline"}], "groupby": ["measure"], "sort": [{"field": "year"}], "frame": [null, null]},
    {"calculate": "100 * datum.value / datum.baseline", "as": "index"}
  ],
  "width": "container",
  "height": 300,
  "padding": {"left": 5, "top": 5, "bottom": 5, "right": 125},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "axis": {"title": "Financial year", "labelAngle": 0}, "scale": {"padding": 0.15}},
    "y": {"field": "index", "type": "quantitative", "scale": {"domain": [40, 170]}, "axis": {"title": "Index (2019–20 = 100)", "tickCount": 6}},
    "color": {
      "field": "measure",
      "type": "nominal",
      "scale": {"domain": ["Digital loans", "Program attendances", "Visits in person", "Registered members"], "range": ["#1C7ED6", "#FAB005", "#F76707", "#7048E8"]},
      "legend": null
    }
  },
  "layer": [
    {
      "data": {"values": [{"from": "2020-21", "to": "2021-22"}]},
      "mark": {"type": "rect", "color": "#EEF2F8", "opacity": 0.8},
      "encoding": {
        "x": {"field": "from", "type": "ordinal"},
        "x2": {"field": "to"},
        "y": {"value": 0},
        "y2": {"value": 300},
        "color": {"value": "#EEF2F8"}
      }
    },
    {
      "data": {"values": [{"year": "2020-21", "label": "COVID-19 closures"}]},
      "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 4, "dy": 6, "fontSize": 11, "fontStyle": "italic", "color": "#5C5F7A"},
      "encoding": {"x": {"field": "year", "type": "ordinal"}, "y": {"value": 0}, "text": {"field": "label"}, "color": {"value": "#5C5F7A"}}
    },
    {
      "description": "Callout at the lowest point of the closures.",
      "data": {"values": [{"year": "2021-22", "y": 47, "note": "Low point: programs at 55, visits at 67"}]},
      "mark": {"type": "text", "align": "center", "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"x": {"field": "year", "type": "ordinal"}, "y": {"field": "y", "type": "quantitative"}, "text": {"field": "note"}, "color": {"value": "#3F4366"}}
    },
    {
      "mark": {"type": "rule", "color": "#A9AFC2", "strokeDash": [3, 3]},
      "encoding": {"y": {"datum": 100}, "x": null, "color": {"value": "#A9AFC2"}}
    },
    {
      "mark": {"type": "line", "strokeWidth": 3, "point": {"filled": true, "size": 60}},
      "encoding": {
        "tooltip": [
          {"field": "measure", "title": "Measure"},
          {"field": "year", "title": "Year"},
          {"field": "value", "type": "quantitative", "title": "Count", "format": ",.0f"},
          {"field": "index", "type": "quantitative", "title": "Index", "format": ".0f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.year === '2023-24'"},
        {"calculate": "datum.index + (datum.measure === 'Program attendances' ? 4 : datum.measure === 'Visits in person' ? -4 : 0)", "as": "labelY"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 9, "fontSize": 11, "fontWeight": "bold"},
      "encoding": {"y": {"field": "labelY", "type": "quantitative"}, "text": {"field": "measure"}}
    }
  ]
}
