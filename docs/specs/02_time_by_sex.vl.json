{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: daily minutes spent on housework, child care and free time by men and women.",
  "data": {"url": "data/time_gender.json"},
  "width": "container",
  "height": 230,
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "sort": ["Housework", "Child care", "Free time"],
      "axis": {"title": null, "labelPadding": 8}
    }
  },
  "layer": [
    {
      "transform": [
        {"aggregate": [{"op": "min", "field": "minutes", "as": "low"}, {"op": "max", "field": "minutes", "as": "high"}], "groupby": ["activity"]}
      ],
      "mark": {"type": "rule", "strokeWidth": 4, "color": "#CDD3E0"},
      "encoding": {
        "x": {"field": "low", "type": "quantitative", "scale": {"domain": [0, 340]}, "axis": {"title": "Minutes per day"}},
        "x2": {"field": "high"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 150, "opacity": 1},
      "encoding": {
        "x": {"field": "minutes", "type": "quantitative"},
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {"domain": ["Men", "Women"], "range": ["#1C7ED6", "#F76707"]},
          "legend": {"orient": "bottom", "title": null}
        },
        "tooltip": [
          {"field": "activity", "title": "Activity"},
          {"field": "sex", "title": "Group"},
          {"field": "minutes", "type": "quantitative", "title": "Minutes per day"}
        ]
      }
    },
    {
      "description": "Annotations under each row describing the gap.",
      "data": {"values": [
        {"activity": "Housework", "x": 20, "note": "Women do about twice as much"},
        {"activity": "Child care", "x": 20, "note": "26 more minutes for women"}
      ]},
      "mark": {"type": "text", "align": "left", "baseline": "top", "dy": 14, "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"x": {"field": "x", "type": "quantitative"}, "text": {"field": "note"}}
    },
    {
      "data": {"values": [{"activity": "Free time", "x": 330, "note": "Men get 24 more minutes"}]},
      "mark": {"type": "text", "align": "right", "baseline": "top", "dy": 14, "fontSize": 11, "fontStyle": "italic", "color": "#3F4366"},
      "encoding": {"x": {"field": "x", "type": "quantitative"}, "text": {"field": "note"}}
    },
    {
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "color": "#5C5F7A"},
      "encoding": {
        "x": {"field": "minutes", "type": "quantitative"},
        "text": {"field": "minutes", "type": "quantitative", "format": ".0f"}
      }
    }
  ]
}
